<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Claude Themes: at login, tells Claude Desktop to load the extension in
     ~/Library/Application Support/Claude/extensions/fmkadmapgofadopljbjfkapdkoienihi
     by setting REACT_PROFILE=1. If that folder is gone, it clears the variable
     instead, so Claude never goes looking for anything else. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claude-themes.env</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>if [ -f "$HOME/Library/Application Support/Claude/extensions/fmkadmapgofadopljbjfkapdkoienihi/manifest.json" ]; then /bin/launchctl setenv REACT_PROFILE 1; else /bin/launchctl unsetenv REACT_PROFILE; fi</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
